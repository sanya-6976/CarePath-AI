# CarePath AI 2.0 Environment Configuration Template
# ===================================================
# Note: Groq API key is optional during development.
# If absent, the reviewer is disabled and the system uses the configured safe fallback behavior.

APP_ENV=development
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security
SECRET_KEY=super_secret_temporary_key_change_in_production_1234567890
PASSWORD_SALT=carepath_security_salt_2026

# Primary AI Model (Gemini 3.6 Flash)
GEMINI_API_KEY=

# Independent AI Reviewer Model (Groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Database Connection (PostgreSQL or automatic SQLite fallback)
DATABASE_URL=postgresql+asyncpg://carepath_admin:carepath_secret_pass@localhost:5432/carepath_db
