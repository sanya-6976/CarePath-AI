# ============================================================
# CarePath AI — Backend Environment Variables Template
# ============================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CarePath AI Backend"
API_V1_STR="/api/v1"
APP_URL="http://localhost:5173"

# ── Security ─────────────────────────────────────────────────
# Generate a strong production secret:
#   python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Generate a strong password salt:
#   python -c "import secrets; print(secrets.token_hex(32))"
PASSWORD_SALT=REPLACE_WITH_STRONG_RANDOM_SALT

# ── Network ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ── Database ─────────────────────────────────────────────────
# Set to your PostgreSQL / Supabase pooler URL for production.
# Falls back to SQLite (carepath_local.db) if PostgreSQL is unreachable.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Supabase (optional — only needed for file storage) ───────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
STORAGE_BUCKET_NAME=medical_files

# ── AI ────────────────────────────────────────────────────────
# Get your key at https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-pro

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".jpg", ".jpeg", ".png", ".txt"]
