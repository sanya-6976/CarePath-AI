# ============================================================
# CarePath AI — Environment Variables Template
# ============================================================
# Copy this file to .env or backend/.env and fill in your values.
# NEVER commit your real secrets to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_ENV=development
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="CarePath AI Backend"
API_V1_STR="/api/v1"
APP_URL="http://localhost:5173"

# ── Security ─────────────────────────────────────────────────
SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_SALT=REPLACE_WITH_STRONG_RANDOM_SALT

# ── Network ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# ── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=carepath_admin
POSTGRES_PASSWORD=carepath_secret_pass
POSTGRES_DB=carepath_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Supabase ──────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
STORAGE_BUCKET_NAME=medical_files

# ── AI ────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-1.5-pro

# ── Vector Store & Cache ──────────────────────────────────────
CHROMADB_HOST=localhost
CHROMADB_PORT=8001
CHROMADB_COLLECTION=clinical_guidelines_v1
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── File Upload ───────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=[".pdf", ".jpg", ".jpeg", ".png", ".txt"]

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=https://carepath-ai-production-508e.up.railway.app
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_KEY=your_supabase_anon_key
VITE_DEV_BYPASS_AUTH=false
